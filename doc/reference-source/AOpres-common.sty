% put a dot in the top right corner when current slide transitions are done
\newcommand{\slidedot}[1][1]
{{
\raggedleft \spk{0ex} {\color{red!30!white} \tiny \only<#1->{$\blacksquare$ \vskip-4.5ex}} \par \vskip-2ex
}}

\newcommand{\usenotes}[2][.7]{% left buttom right...
	\usepackage{pgfpages}
	\setbeameroption{show notes}
	\setbeamertemplate{note page}{
		{\centering \insertslideintonotes{#1}\\ }
		\vskip-4ex\hrule\small \insertnote \par
		{\tiny \insertsectionnavigationhorizontal{.75\tw}{}{}}
	}
	\setbeameroption{show notes on second screen=#2}
}

%% ====================================================== SLIDE AUTOMATION

% sub section / multiple slides for the same section counter
% should be called only by the style file, not in the tex file
\newcounter{subcounter}	% the sub counter
\newcommand{\dosub}{}	% command will be replaced with the appropriate sub number
\newcommand{\sub}{\addtocounter{subcounter}{1}}
\newcommand{\setsub}{\renewcommand{\dosub}{ (\arabic{subcounter})}}
\newcommand{\nosub}{\setcounter{subcounter}{0}\renewcommand{\dosub}{}}	% the slide has no subs
\newcommand{\resub}{\nosub\setsub\sub}		% reset subsection counter
% these below should be called by the tex file
\newcommand{\subA}{\sub\dosub}
\newcommand{\resubA}{\resub\dosub}

\newlength{\contentsspace}
\setlength{\contentsspace}{.05\ph}
% setting contents space:
% .8 / n sections (depending on template)
\newcommand{\setcontents}[1]{\setlength{\contentsspace}{#1\ph}}
\newcommand{\setcontentsManual}[1]{\setlength{\contentsspace}{#1}}


%% ====================================================== SLIDE GENERATION


% handling sections, subsections, and multiple slides per subsection
% there cannot be multiple slides per section, without having subsections

% slide that introduces a new section, with optional short name
% \doslide[ShortSection]{Long Section Title}{content}

% slide that introduces a new section and its first subsection (short title is possible too)
% \doslide{Long Section Title}[Subsection]{content}

% slide that introduces a new subsection
% \doslideNext[Subsection]{content}

% slide that introduces a new subsection that has subsequent slides
% \doslideNext[Subsection][s]{content}

% new slide in the current subsection
% \doslideNext{content}


% each slide (with doslide) begins a section; the optional argument is the short section name
%  an optional argument may follow to begin a new subsection
% each slide with doslidenext with arguments (the subsection) begins a subsection.
%  if another optional argument is placed after the subsection title, the counter begins with this slide
% each slide with doslidenext without arguments continues the subsection and a counter is used
\newcommand{\doslide}[2][]{			\ifx\\#1\\ \section{#2}	\else \section[#1]{#2}		\fi \doslideNext}
\newcommand{\doslideNext}[1][]{		\ifx\\#1\\ \sub 		\else \nosub\subsection{#1}	\fi \autosubber}
\newcommand{\autosubber}[1][]{
\ifx\\#1\\\ifx\\\dosub\\\nosub\else\fi\else \resub\fi\doslideaux}
\newcommand{\doslideaux}[2][.9\pw]{	\modeheadline\slidecontent{#1}{#2}	}

% #1 horizontal alignment; #2 overall width; #3 content
% central vertical alignment; 2ex parskip 
\newcommand{\slidecontent}[3][\centering]{
\begin{frame}[c]#1
\begin{minipage}[c]{#2}\spk{2ex}
#3
\end{minipage}\par
\end{frame}
}

% commands to be used just like the ones above, but without integrating the actual slide
% usage:	\preslide[Section Short]{Section}[First Subsection][s for multiple slides]
%			\preslideNext[Subsection][s for multiple slides]

\newcommand{\preslide}[2][]{		\ifx\\#1\\ \section{#2}	\else \section[#1]{#2}		\fi \preslideNext}
\newcommand{\preslideNext}[1][]{	\ifx\\#1\\ 		 		\else \nosub\subsection{#1}	\fi \autosubberP}
\newcommand{\autosubberP}[1][]{\ifx\\#1\\	\sub	\else \resub\fi\modeheadline }

\newcommand{\sd}[2][]{\ifx\\#1\\\section{#2}\else \section[#1]{#2}\fi \nosub\sn}
\newcommand{\sn}[1][]{	\ifx\\#1\\ 	\else \nosub\subsection{#1}	\fi \autosubberP}

\newenvironment{fm}{\begin{frame}\spk{2ex}}{\end{frame}}

\newcommand{\modesidebar}[3][.5mm]{		\setbeamertemplate{headline}{}
	\defsidebar[#1]{#2}{#3}
	\setbeamertemplate{sidebar left}{\insertverticalnavigation{.3\pw}}
}

% use 'skip' to skip navigation
\newcommand{\modeheadline}[1][]{	\setbeamertemplate{sidebar left}{}
	\setbeamertemplate{headline}{\insertsectionnavigationhorizontal{.9\pw}{}{}}
}

% arguments: left margin, normal and shaded sidebar section entry
\newcommand{\defsidebar}[3][.5mm]{
\ifx\\#2\\ \setbeamertemplate{section in sidebar}{} \else
\setbeamertemplate{section in sidebar}{	\begin{beamercolorbox}[ht = \contentsspace]{a}
	\hspace{#1} #2
\end{beamercolorbox}	}
\fi
\ifx\\#3\\ \setbeamertemplate{section in sidebar shaded}{} \else
\setbeamertemplate{section in sidebar shaded}{	\begin{beamercolorbox}[ht = \contentsspace]{a}
	\hspace{#1} #3
\end{beamercolorbox}	}
\fi
}

