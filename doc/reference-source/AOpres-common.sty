\newcommand{\seeruler}{{
\vspace*{-1.95ex}\tiny
\begin{tabular}{|@{}p{.25\tw}@{}|@{}p{.25\tw}@{}|@{}p{.25\tw}@{}|@{}p{.25\tw}@{}|}\hline&&&\\\end{tabular}
