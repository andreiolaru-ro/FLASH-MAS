%% ====================================================== TEXT COMMANDS

\newcommand{\hilite}{\alert} % red (template color)
\newcommand{\hiliteA}[2][blue!90!white]{{\color{#1} #2}} % blue
\newcommand{\hiliteC}[2][blue!30!white]{\colorbox{#1}{#2}} % default blue bkg

\newcommand<>{\at}[3][\tw]{\begin{overlayarea}{#1}{#2}\only#4{#3}\end{overlayarea}}

\newcommand{\nt}[3][1-]	% note; note appears in a minipage to the right, with a left arrow, in grey; use \rr to avoid underfulls
{
	\only<#1>{ {\small $\leftarrow$ \begin{minipage}{#2\tw} \color{black!70!white} #3 \end{minipage}} }
}
\newcommand{\rr}{\raggedright}
\newcommand{\rl}{\raggedleft}
\newcommand{\ct}{\centering}

\newcommand{\citationcolor}{\color{black!50}}
\newcommand{\urlcolor}{\color{blue!90}}
\newcommand{\docite}[2][]{{\tiny \citationcolor \cite{#2}\ifx&#1& \else[#1]\fi}}		% uses cite
\newcommand{\dociteN}[1]{{\scriptsize \citationcolor \cite{#1}}}	% uses cite, larger text than \docite
\newcommand{\dociteA}[2][\scriptsize]{{\citationcolor #1 [#2]}}			% normal text, grey, brackets
\newcommand{\dociteU}[2][\scriptsize]{{\citationcolor #1 [\url{#2}]}}	% url, grey, brackets
\newcommand{\dociteH}[2]{{\urlcolor \href{#2}{{\scriptsize[#1]}}}}				% title and url, blue, normal
\newcommand{\dourl}[1]{{\footnotesize \urlcolor \url{#1}}}		% url, blue, small

% \contribution[pic size]{pic name}{name}[affiliation pic height]{affiliation}[box width]{contrib}
% affiliation and contribution can be missing, but the respective parameters must still be present (and empty)
\newlength{\picsize}\setlength{\picsize}{1ex}
\newcommand{\contribution}[2][3ex]{	\setlength{\picsize}{#1}\parbox[c]{\picsize}{\picG[width=\picsize]{people/#2}}	\contribS}
\newcommand{\contribS}[2][]{\hiliteA{#2}\contribSX}
\newcommand{\contribSX}[2][]{\ifx\\#1\\#2\else\picPub[height=#1]{#2}\fi\contribSXX}
\newcommand{\contribSXX}[2][.6]{\ifx\\#2\\\else\nl\hspace*{\picsize}\hspace*{1ex}\parbox{#1\tw}{{\color{blue}\hrule} \vspace*{1ex}#2}\\\fi\contribSXXX}
\newcommand{\contribSXXX}[1][1ex]{\ifx\\#1\\\else\vspace*{#1}\fi}

\ifdefined\quickspaces
\renewcommand{\v}[1][]{\ifx\\#1\\\vskip1ex\else\vspace*{#1}\fi}
\newcommand{\h}[1][]{\ifx\\#1\\\hskip1ex\else\hspace*{#1}\fi}
\fi

