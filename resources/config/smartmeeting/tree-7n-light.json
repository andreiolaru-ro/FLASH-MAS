{
  "scenarioName": "sm-tree-7n-light",
  "description": "Tree topology with lobby + 6 rooms, 1 auction agent, 3 person requesters. Low contention regime: 3 persons / 6 rooms means most requests can be accommodated.",
  "runs": 100,
  "steps": 60,
  "baseSeed": 42,
  "logLevel": "ERROR",
  "graph": {
    "nodes": ["lobby", "r1", "r2", "r3", "r4", "r5", "r6"],
    "edges": ["lobby-r1", "lobby-r2", "lobby-r3", "r1-r4", "r3-r5", "r5-r6"]
  },
  "agents": [
    {
      "kind": "Auction",
      "count": 1,
      "params": { "releaseAfterSteps": 20 }
    },
    {
      "kind": "Room",
      "count": 6,
      "params": {
        "capacity": 8,
        "equipment": "PROJECTOR,WHITEBOARD,VIDEO_CONFERENCE"
      }
    },
    {
      "kind": "Person",
      "count": 3,
      "params": {
        "auctionAgent": "auction0",
        "attendeesMin": 2,
        "attendeesMax": 8,
        "durations": "30,60",
        "startMin": 540,
        "startMax": 720,
        "startStep": 30,
        "priorityMin": 1,
        "priorityMax": 3,
        "equipmentPool": "PROJECTOR",
        "equipmentProb": 0.5
      }
    }
  ]
}
