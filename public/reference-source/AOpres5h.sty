% AOpres
% forked from AOpres5
% content slides have horizontal header with horizontal section navigation and right-side vertical subsection navigation
% slides are organized in sections, subsection, and potentially multiple slides per subsection

% USE:
%
% from the RSH article folders. just:
% \usepackage{../_package/AOpres5h}
%
% from other locations:
% \def\elementsroot{path/to/RSH/}\usepackage{\elementsroot_package/AOpres5h}

% packages
\ifdefined\flatpack\usepackage{AOpres-common}\else\ifdefined\elementsroot\usepackage{\elementsroot_package/AOpres-common}\else\usepackage{../_package/AOpres-common}\fi\fi



% text commands

\renewenvironment{fm}[1][2ex]{\begin{frame}\spk{2ex}\vspace*{#1}}{\end{frame}}

\renewcommand{\hiliteA}[2][cyan!60!blue]{{\color{#1} #2}} % blue

\setbeamertemplate{itemize items}{\color{cyan!40!white}\tiny$\blacksquare$}
\setbeamersize{text margin left=.07\pw,text margin right=.07\pw}
\let\OLDitemize\itemize \renewcommand\itemize{\OLDitemize\addtolength{\itemsep}{2ex}}


