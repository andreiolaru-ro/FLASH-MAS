<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.2" snapToGrid="true">
  <code><![CDATA[;; Wolf-Sheep with the same rules and setup as the FLASH-MAS WolfSheepBoot scenario
;; (src-experiments/abms/wolfSheepPredation), to compare execution times.
;;
;; As in FLASH-MAS:
;; - the world is a bounded grid (no wrapping), 6 * floor(sqrt(scale)) cells per side;
;; - grass, sheep and wolves start on distinct random cells; only the cells that start with grass have grass;
;; - a neighbourhood is the 8 surrounding cells, distances are Chebyshev distances (max of |dx| and |dy|),
;;   vision is the square of that radius around the agent, without its own cell;
;; - there is no energy and no reproduction: a wolf eats every sheep on its cell, a sheep eats the grass on its cell;
;; - in each tick, the grass patches, sheep and wolves act one by one, in one mixed order that is fixed for the whole
;;   run (as the FLASH-MAS executor goes through its entities), and each of them receives its messages just before
;;   acting, so a grass patch is eaten or grows back when its turn comes;
;; - moves and eaten sheep are applied at the end of the tick, and messages (eat requests, wolf alerts) sent in a
;;   tick are delivered at the next tick.

globals [
  scale
  steps
  regrowth-time
  sheep-vision
  wolf-vision
  sheep-vision-offsets   ; [dx dy] of the cells a sheep sees
  wolf-vision-offsets    ; [dx dy] of the cells a wolf sees
  setup-ms
  go-ms
  grass-eaten-count
  sheep-eaten-count
  entity-order           ; grass patches, sheep and wolves in one mixed order, fixed for the whole run
]

breed [sheep a-sheep]
breed [wolves wolf]

patches-own [
  has-grass?      ; the cell holds a grass patch
  grown?
  countdown       ; steps until the grass grows back
  eat-requested?  ; a sheep asked to eat the grass at the previous tick (delivered at this tick)
  eat-incoming?   ; a sheep asked to eat the grass at this tick (delivered at the next tick)
]

turtles-own [
  next-patch      ; where the turtle moves at the end of the tick
]

sheep-own [
  eaten?          ; eaten by a wolf this tick (removed at the end of the tick)
  alert?          ; received a wolf alert (as in FLASH-MAS, it does not change the behaviour)
  alert-next?     ; alert sent at the previous tick, delivered at this tick
  alert-incoming? ; alert sent at this tick, delivered at the next tick
]

to setup
  clear-all
  reset-timer
  set scale 289
  set steps 100
  set regrowth-time 5
  set sheep-vision 2
  set wolf-vision 3
  let side 6 * floor sqrt scale
  resize-world 0 (side - 1) 0 (side - 1)
  set sheep-vision-offsets chebyshev-offsets sheep-vision
  set wolf-vision-offsets chebyshev-offsets wolf-vision
  random-seed 42
  let n-grass 15 * scale
  let n-sheep 10 * scale
  let n-wolves 5 * scale
  ask patches [
    set has-grass? false
    set grown? false
    set countdown 0
    set eat-requested? false
    set eat-incoming? false
  ]
  ; distinct random cells, in random order: first the grass, then the sheep, then the wolves
  let cells [self] of n-of (n-grass + n-sheep + n-wolves) patches
  foreach sublist cells 0 n-grass [ c ->
    ask c [ set has-grass? true set grown? true set pcolor green ]
  ]
  foreach sublist cells n-grass (n-grass + n-sheep) [ c ->
    ask c [ sprout-sheep 1 [ set color white set eaten? false set alert? false set alert-next? false set alert-incoming? false ] ]
  ]
  foreach sublist cells (n-grass + n-sheep) (n-grass + n-sheep + n-wolves) [ c ->
    ask c [ sprout-wolves 1 [ set color black ] ]
  ]
  set entity-order shuffle (sentence [self] of patches with [has-grass?] [self] of sheep [self] of wolves)
  reset-ticks
  set setup-ms timer * 1000
  reset-timer
end

to go
  ; every entity acts in the same mixed order at every tick, and receives its messages just before acting
  foreach entity-order [ a ->
    if a != nobody [
      ifelse is-patch? a [ ask a [ grass-turn ] ] [
        ifelse is-a-sheep? a [ ask a [ sheep-turn ] ] [ ask a [ wolf-step ] ]
      ]
    ]
  ]
  ; actions are applied at the end of the tick, messages sent in this tick are delivered at the next one
  ask sheep with [eaten?] [
    set sheep-eaten-count sheep-eaten-count + 1
    die
  ]
  ask turtles [ move-to next-patch ]
  ask patches with [eat-incoming?] [ set eat-requested? true set eat-incoming? false ]
  ask sheep [ set alert-next? alert-incoming? set alert-incoming? false ]
  tick
end

to grass-turn ; patch procedure
  if eat-requested? [
    if grown? [
      set grown? false
      set countdown regrowth-time
      set grass-eaten-count grass-eaten-count + 1
    ]
    set eat-requested? false
  ]
  if not grown? [ grass-step ]
end

to sheep-turn ; sheep procedure
  set alert? alert-next?
  set alert-next? false
  sheep-step
end

to grass-step ; patch procedure
  set countdown countdown - 1
  if countdown <= 0 [ set grown? true ]
end

to sheep-step ; sheep procedure
  if grown? [ set eat-incoming? true ]
  if any? wolves-on neighbors [
    ask sheep-on neighbors [ set alert-incoming? true ]
  ]
  let here patch-here
  let visible-grass (patches at-points sheep-vision-offsets) with [grown?]
  ifelse any? visible-grass [
    let target min-one-of visible-grass [cheb-to here]
    set next-patch min-one-of neighbors [cheb-to target]
  ] [
    set next-patch one-of neighbors
  ]
end

to wolf-step ; wolf procedure
  ask sheep-here [ set eaten? true ]
  let here patch-here
  let visible-sheep (patches at-points wolf-vision-offsets) with [any? sheep-here]
  ifelse any? visible-sheep [
    let target min-one-of visible-sheep [cheb-to here]
    set next-patch min-one-of neighbors [cheb-to target]
  ] [
    set next-patch one-of neighbors
  ]
end

;; Chebyshev distance from this patch to another one
to-report cheb-to [p] ; patch reporter
  report max (list abs (pxcor - [pxcor] of p) abs (pycor - [pycor] of p))
end

;; the [dx dy] offsets within Chebyshev radius r, without [0 0]
to-report chebyshev-offsets [r]
  let offsets []
  foreach (range (- r) (r + 1)) [ ox ->
    foreach (range (- r) (r + 1)) [ oy ->
      if ox != 0 or oy != 0 [ set offsets lput (list ox oy) offsets ]
    ]
  ]
  report offsets
end

;; setup + steps ticks without drawing the view, then prints the times and the results
to benchmark
  no-display
  setup
  repeat steps [ go ]
  set go-ms timer * 1000
  display
  print (word "setup " precision setup-ms 0 " ms, " steps " steps " precision go-ms 0 " ms | sheep left "
    count sheep ", wolves " count wolves ", sheep eaten " sheep-eaten-count ", grass eaten " grass-eaten-count)
end]]></code>
  <widgets>
    <view x="210" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="0" height="510" showTickCounter="true" patchSize="5.0" fontSize="10" wrappingAllowedY="false" width="510" tickCounterLabel="ticks" maxPycor="101" updateMode="1" maxPxcor="101" minPxcor="0"></view>
    <button x="10" y="10" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="90" display="setup">setup</button>
    <button x="110" y="10" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="90" display="go">if ticks >= steps [ stop ]
go</button>
    <button x="10" y="60" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="190" display="benchmark">benchmark</button>
    <monitor x="10" precision="0" y="110" height="60" fontSize="11" width="90" display="sheep">count sheep</monitor>
    <monitor x="110" precision="0" y="110" height="60" fontSize="11" width="90" display="wolves">count wolves</monitor>
    <monitor x="10" precision="0" y="180" height="60" fontSize="11" width="90" display="setup ms">setup-ms</monitor>
    <monitor x="110" precision="0" y="180" height="60" fontSize="11" width="90" display="go ms">go-ms</monitor>
  </widgets>
  <info><![CDATA[## WHAT IS IT?

Wolf-Sheep with the same rules and setup as the FLASH-MAS WolfSheepBoot scenario (scale 289: a 102 x 102 grid, 4335 grass patches, 2890 sheep, 1445 wolves, 100 steps), used to compare execution times between FLASH-MAS and NetLogo.

## HOW TO USE IT

Press **benchmark** (or type `benchmark` in the Command Center): it runs setup and 100 ticks without drawing the view and prints the setup time, the time of the 100 ticks and the results.

Headless, with the **benchmark** BehaviorSpace experiment (10 repetitions, one thread):

    ./NetLogo_Console --headless --model WolfSheepFMAS.nlogox --experiment benchmark --threads 1 --table -
]]></info>
